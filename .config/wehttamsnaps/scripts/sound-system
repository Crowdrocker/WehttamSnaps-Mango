    greeting-auto)  greeting_auto ;;

    # Alerts & Warnings
    alert-high)     alert_high ;;
    alert-medium)   alert_medium ;;
    warning)        warning ;;
    error)          error ;;
    performance-warn) performance_warn ;;

    # System Status
    battery-critical) battery_critical ;;
    low-memory)     low_memory ;;
    disk-space)     disk_space ;;
    plugged-in)     plugged_in ;;
    unplugged)      unplugged ;;

    # Development
    compile-success) compile_success ;;
    compile-error)  compile_error ;;
    git-pull)       git_pull ;;
    git-push)       git_push ;;
    deploy)         deploy ;;
    update)         update ;;

    # Completions
    backup-complete) backup_complete ;;
    download-complete) download_complete ;;
    upload-complete) upload_complete ;;

    # Productivity
    meeting-reminder) meeting_reminder ;;
    break-reminder) break_reminder ;;
    focus-mode)     focus_mode ;;

    # Network
    vpn-connected)  vpn_connected ;;
    vpn-disconnected) vpn_disconnected ;;

    # Media Controls
    music-play)     music_play ;;
    music-pause)    music_pause ;;
    music-next)     music_next ;;
    music-previous) music_previous ;;

    # Voice Assistant
    listening)      listening ;;
    confirm)        confirm ;;
    app-not-found)  app_not_found ;;
    command-unknown) command_unknown ;;
    you-welcome)    you_welcome ;;
    status-report)  status_report ;;

    # Search
    search-google)  search_google ;;
    search-github)  search_github ;;
    search-youtube) search_youtube ;;

    # Gaming Mode
    gamemode-on)    gamemode_on ;;
    gamemode-off)   gamemode_off ;;
    gaming-toggle)
        [[ -f "$GAMING_FLAG" ]] && gamemode_off || gamemode_on
        ;;

    # Workspace
    workspace)      workspace_switch "${2:-1}" ;;
    workspace-next) workspace_next ;;
    workspace-previous) workspace_previous ;;
    mode)           set_mode "${2:-jarvis}" ;;
    auto-mode)      set_mode "$(auto_detect_mode)" ;;

    # Utilities
    play)           play_sound "${2:-startup}" "${3:-}" ;;
    status)         show_status ;;
    list)           list_sounds ;;
    test)           test_all_sounds ;;

    help|--help|-h) show_help ;;
    *)
        echo -e "${RED}✗${NC} Unknown command: $1"
        echo "Run 'sound-system help' for usage"
        exit 1
        ;;
esac
