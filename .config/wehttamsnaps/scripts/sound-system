# ═══════════════════════════════════════════════════════════════════════════════
#  MAIN DISPATCHER
# ═══════════════════════════════════════════════════════════════════════════════

case "${1:-help}" in
    # Audio Controls
    mute)           audio_mute_toggle ;;
    volume-up)      audio_volume_up ;;
    volume-down)    audio_volume_down ;;
    mic-mute)       mic_mute_toggle ;;

    # Application Launchers
    launch-brave)   launch_brave ;;
    launch-firefox) launch_firefox ;;
    launch-chrome)  launch_chrome ;;
    launch-discord) launch_discord ;;
    launch-editor)  launch_editor ;;
    launch-gimp)    launch_gimp ;;
    launch-kate)    launch_kate ;;
    launch-obs)     launch_obs ;;
    launch-spotify) launch_spotify ;;
    open-terminal)  open_terminal ;;
    open-files)     open_files ;;
    steam-launch)   steam_launch ;;

    # System Events
    startup)        system_startup ;;
    shutdown)       system_shutdown ;;
    notification)   notification ;;
    discord-notify) discord_notify ;;
    screenshot)     screenshot_taken ;;
    window-close)   window_close ;;
    window-center)  window_center ;;
    window-tile)    window_tile ;;
    window-float)   window_float ;;
    window-fullscreen) window_fullscreen ;;
    config-reload)  config_reload ;;
    locking-screen) locking_screen ;;
    photo-export)   photo_export ;;
    photo-mode)     photo_mode ;;
    streaming)      streaming_on ;;

    # Greetings
    greeting)       greeting ;;
    morning)        morning_greeting ;;
    afternoon)      afternoon_greeting ;;
