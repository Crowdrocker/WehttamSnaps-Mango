#  APPLICATION LAUNCHERS
# ─────────────────────────────────────────────────────────────────────────────

launch_brave()       { play_sound "launch-brave"; }
launch_firefox()     { play_sound "launch-firefox"; }
launch_chrome()      { play_sound "launch-chrome"; }
launch_discord()     { play_sound "launch-discord"; }
launch_editor()      { play_sound "launch-editor"; }
