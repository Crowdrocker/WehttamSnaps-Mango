# ─────────────────────────────────────────────────────────────────────────────
#  GREETINGS (Time-based)
# ─────────────────────────────────────────────────────────────────────────────

greeting()           { play_sound "greeting"; }
morning_greeting()   { play_sound "morning"; }
afternoon_greeting() { play_sound "afternoon"; }
evening_greeting()   { play_sound "evening"; }

# Time-aware greeting
greeting_auto() {
    local hour
    hour=$(date +%H)
    if (( hour >= 5 && hour < 12 )); then
        morning_greeting
    elif (( hour >= 12 && hour < 17 )); then
        afternoon_greeting
    else
        evening_greeting
    fi
}

