[Desktop Entry]
Name=Event Horizon Package Manager
Comment=Install and manage system packages
Exec=/home/wehttamsnaps/.config/quickshell/scripts/open-pkg-manager.sh %F
Icon=/home/wehttamsnaps/.config/quickshell/assets/Event-Horizon-logo.png
Terminal=false
Type=Application
Categories=System;PackageManager;
MimeType=application/x-deb;application/x-rpm;application/x-redhat-package-manager;application/x-rpm;application/vnd.debian.binary-package;application/x-archive;application/zstd;application/x-zstd-compressed-tar;application/x-tar;
NoDisplay=true
